JWT_ACCESS_SECRET=test-access-secret-key-must-be-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=test-refresh-secret-key-must-be-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Uploads
UPLOAD_DIR=public/uploads-test
PUBLIC_SERVE_ROOT=/public/uploads
MAX_AVATAR_SIZE_BYTES=5242880
