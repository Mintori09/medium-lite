NODE_ENV=test
PORT=3001
DB_HOST=localhost
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=medium_lite_test
POSTGRES_PORT=5432
DATABASE_URL=postgresql://admin:admin123@localhost:5432/medium_lite_test?schema=public

REDIS_HOST=localhost
